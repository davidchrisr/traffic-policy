[Unit]
Description=Traffic Policy privileged enforcement service
Wants=tp-forward-guard.service
After=local-fs.target systemd-modules-load.service systemd-sysctl.service tp-forward-guard.service
Before=tp-gateway.service

[Service]
Type=notify
NotifyAccess=all
User=root
Group=traffic-policy
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
LimitNOFILE=16384
ExecStart=/opt/traffic-policy/runtime/bin/bun --no-install /opt/traffic-policy/app/enforcement.mjs /etc/traffic-policy/enforcement.json
Restart=on-failure
RestartSec=3
RuntimeDirectory=traffic-policy
RuntimeDirectoryMode=0750
# Preserve lock inodes even when a duplicate service invocation fails.
RuntimeDirectoryPreserve=yes
StateDirectory=traffic-policy/enforcement
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/traffic-policy/enforcement /run/traffic-policy
UMask=0077
MemoryMax=512M
TasksMax=64
SyslogIdentifier=tp-enforcement

[Install]
WantedBy=multi-user.target
