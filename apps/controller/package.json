{
  "name": "@traffic-policy/controller",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun run vite --host 0.0.0.0",
    "build": "bun --bun run vite build",
    "catalog": "bun --bun run vite --config catalog/vite.config.ts",
    "check": "bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@traffic-policy/contracts": "workspace:*",
    "@traffic-policy/core": "workspace:*",
    "svelte": "5.57.2",
    "@node-rs/argon2": "2.2.2",
    "zod": "4.6.7",
    "bits-ui": "2.19.5",
    "tailwind-variants": "3.3.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@lucide/svelte": "1.52.0",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.6",
    "vite": "8.3.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
