{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "catalog", "*.ts"],
  "exclude": ["node_modules", "build"]
}
