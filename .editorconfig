root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
shell_variant = bash
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = false
space_redirects = false
function_next_line = false

[**/.local/**]
ignore = true
