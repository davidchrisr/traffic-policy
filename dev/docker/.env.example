# Copy to an ignored .env.<name> file. See README.md for configuration and startup.
# Independent stacks need distinct project names, browser ports, and nonoverlapping subnets.
# Adjust the example allocations below for the host.
COMPOSE_PROJECT_NAME=tp-dev-development
TP_BROWSER_PORT=9444
TP_UPSTREAM_SUBNET=172.30.0.0/24
TP_CONTROLLER_ADDRESS=172.30.0.200
TP_CLIENTS_SUBNET=172.30.1.0/24
TP_CLIENT_ADDRESS=172.30.1.200

# A browser on the same host: loopback origin and binding.
TP_BROWSER_TRANSPORT=http-local-test
TP_BROWSER_BIND=127.0.0.1
TP_ORIGIN=http://localhost:9444
# A browser on another machine: the host's private IPv4 address instead.
# TP_BROWSER_TRANSPORT=http-lan-test
# TP_BROWSER_BIND=0.0.0.0
# TP_ORIGIN=http://192.168.1.20:9444

# A file holding Admin's password, read once by the init service as a Compose secret. Keep it
# outside the repository and readable only by you; there is no default password.
TP_ADMIN_PASSWORD_FILE=

# Bytes each DNS listener requests. Unprivileged containers cannot raise net.core.rmem_max, so the
# default fits stock kernels; a larger value than the host allows reports dns_receive_buffer.
TP_DNS_RECEIVE_BUFFER_BYTES=131072
